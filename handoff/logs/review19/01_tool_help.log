  --b B                 cau hinh B dang ten:duong_dan_yaml
  --conf-min CONF_MIN
  --classes [CLASSES [CLASSES ...]]
  --max-det MAX_DET
  --fps FPS
  --track-buffer-sec TRACK_BUFFER_SEC
