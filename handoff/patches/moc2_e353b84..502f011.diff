++    unreadable = np.zeros(F, bool); unreadable[11] = True     # frame 12
++    empty = {15}
++    data, n_per = [], []
++    for f in range(1, F + 1):
++        rows = []
++        if not unreadable[f - 1] and f not in empty:
++            step = t[f - 1] / DT
++            xa = 100 + 5.0 * step
