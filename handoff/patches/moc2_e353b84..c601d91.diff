++_RESULTS: list[tuple[str, bool]] = []
++DT = 0.04
++
++
++def _check(name, ok, detail=""):
++    _RESULTS.append((name, ok))
++    print(f"  [{'PASS' if ok else 'FAIL'}] {name}")
++    if detail:
++        for line in str(detail).strip().splitlines():
++            print(f"         {line}")
++    assert ok, name
++
