+++#: (exp, cond, truc, mo ta thanh phan thay doi theo tracker, tracker tham chieu)
+++AXES = [
+++    ("expC1_buffer_dev", "c25", "C1 track_buffer",
+++     lambda t: f"track_buffer = {t.split('-b')[1]} s ({'CV' if t.startswith('cv') else 'EKF'})",
