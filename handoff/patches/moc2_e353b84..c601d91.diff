++    if not len(m):
++        return float("nan")
++    cols = ["bb_left", "bb_top", "bb_width", "bb_height"]
++    return float(np.abs(m[[c + "_a" for c in cols]].to_numpy()
++                        - m[[c + "_b" for c in cols]].to_numpy()).max())
