++    lines.append(f"  - track {g('id_before')} tai frame do: trang thai {g('state_at_fdet')}, da mat {g('n_lost_at_fdet')} buoc, "
++                 f"IoU(du doan, det) = {g('iou_pred_det')}, lech tam {g('center_offset_px')} px, "
