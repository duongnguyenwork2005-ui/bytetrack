+++            for name in ("summary.csv", "run_meta.json"):
+++                if (d / name).exists():
+++                    files.add((d / name).relative_to(ROOT))
+++    # cache detection
+++    for cdir in (ROOT / "data" / "interim" / "det_cache").glob("*"):
+++        if not cdir.is_dir():
