++        idb = int(df[df.frame == 1].sort_values("bb_left").id.iloc[1])
++        logged = tracks[(tracks.frame == 9) & (tracks.track_id == ida)][["x", "y", "w", "h"]].to_numpy()[0]
++        tr2 = run_tracking.make_tracker(cfg)
++        if hasattr(tr2, "set_seed"):
