+++            "P_theta_sum": float(np.sum(p_th)) if p_th else float("nan"),
+++            "P_cx_mean": float(np.mean(p_cx)) if p_cx else float("nan"),
+++            "trace_theta": np.asarray(p_th), "trace_cx": np.asarray(p_cx)}
+++
