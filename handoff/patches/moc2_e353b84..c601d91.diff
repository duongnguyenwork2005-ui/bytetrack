+++"""
+++from __future__ import annotations
+++
+++import argparse
+++import hashlib
+++import json
+++import platform
+++import subprocess
+++import sys
+++import time
+++from pathlib import Path
+++
+++sys.path.insert(0, str(Path(__file__).resolve().parent))
+++import config  # noqa: E402
