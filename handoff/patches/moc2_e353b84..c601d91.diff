+++    for p in (ROOT / "results" / "phase2").rglob("*"):
+++        if p.is_file() and p.suffix.lower() in RESULT_EXT and "prefix" not in p.parts and "fixed" not in p.parts:
+++            files.add(p.relative_to(ROOT))
+++    for split in splits:
