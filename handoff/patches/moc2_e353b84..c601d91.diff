+++
+++
+++def tracked_files() -> list[str]:
+++    return [ln for ln in git("ls-files").splitlines() if ln]
+++
+++
+++def collect(cache_max_mb: float, splits: list[str]) -> tuple[list[Path], list[str]]:
+++    files: set[Path] = set()
+++    notes: list[str] = []
