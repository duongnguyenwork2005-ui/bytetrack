+++    idx = ["# INDEX - handoff/phase2_review_latest.zip", "", f"Tao: {time.strftime('%Y-%m-%d %H:%M:%S')}  HEAD {git('rev-parse', '--short', 'HEAD').strip()}", "",
+++           "## Ghi chu dong goi", *[f"- {n}" for n in notes],
