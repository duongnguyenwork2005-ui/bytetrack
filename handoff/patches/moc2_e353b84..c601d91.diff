++            rows.append((i, int(b[4]), float(b[0]), float(b[1]), float(b[2] - b[0]), float(b[3] - b[1])))
++    return pd.DataFrame(rows, columns=["frame", "id", "bb_left", "bb_top", "bb_width", "bb_height"])
++
