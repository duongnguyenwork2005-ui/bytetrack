++               "pf_roughening": cfg.get("pf_roughening"), "pf_degenerate_maha2": cfg.get("pf_degenerate_maha2"),
++               "track_buffer": cfg.get("track_buffer"),
++               "ess_ratio_mean": upd.ess_ratio.mean(), "ess_ratio_p10": upd.ess_ratio.quantile(0.10),
