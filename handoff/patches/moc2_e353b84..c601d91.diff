++++    stamp = time.strftime("%Y%m%d-%H%M")
++++    log_path = out / f"tests_{stamp}.log"
++++    rows = []
++++    with log_path.open("w", encoding="utf-8") as log:
++++        log.write(f"# run_all_tests {time.strftime('%Y-%m-%d %H:%M:%S')}  python={sys.version.split()[0]}  cwd={ROOT}\n")
++++        try:
