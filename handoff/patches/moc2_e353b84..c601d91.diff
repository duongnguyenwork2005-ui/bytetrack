+++            "handoff/INDEX.md", "handoff/large_inputs.md", "handoff/logs/tests_summary.csv", "handoff/logs/tests_latest.log",
+++            "configs/phase2/PREREG_moc2.md", "configs/phase2/LOCK_moc2.md"]
