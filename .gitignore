# --- Du lieu goc / da giai nen: qua lon (~10GB) va la dataset co ban quyen,
#     KHONG redistribute. Xem README.md muc "Tai bo anh train" de tai lai. ---
data/raw/
data/extracted/

# --- File trung gian nang, tai tao duoc bang script (xem README) ---
data/interim/*.parquet

# --- Ket qua tracking THO cua 60 video (Giai doan 5): 146 MB, 180 file .txt.
#     Tai tao duoc bang src/baseline_track.py (~3 gio GPU). Moi ket qua DA PHAN
#     TICH (TrackEval, phan tang, McNemar, hinh) van duoc commit trong results/.
#     Ket qua cua DETRAC-sample (5 video, nhe) van giu lai de doi chung. ---
data/processed/trackers/DETRAC-all/

# --- Trong so model (.pt) - tu dong tai lai boi ultralytics / src/baseline_track.py ---
models/*.pt

# --- Python ---
__pycache__/
*.pyc
*.pyo
.ipynb_checkpoints/

# --- Ultralytics tao ra khi train/predict (khong dung o project nay nhung de phong) ---
runs/

# --- OS / editor ---
.DS_Store
Thumbs.db
.vscode/

# --- Claude Code local state (khong lien quan noi dung du an) ---
.claude/

# --- File rong do IDE tao ra, khong thuoc du an ---
/test

# --- Giai doan C: dataset YOLO xuat ra (382 MB) va trong so fine-tune (36 MB).
#     Dataset tai tao duoc bang src/export_yolo_dataset.py (~2 phut).
#     Trong so tai tao duoc bang huan luyen lai (~3.8 gio GPU) - giu lai file
#     models/finetune/finetune_metrics.json va results/phaseC/ de doi chung. ---
data/yolo_detrac/
models/finetune/fold*/
models/finetune/trainall/
data/processed/trackers/DETRAC-test/

# --- Video minh hoa NANG. 4 video demo goc (1-3 MB) van duoc commit; nhung
#     video duoi day 10-127 MB nen chi giu script sinh ra chung:
#       sbs_*.mp4        <- src/demo/side_by_side.py   (~1 phut/video)
#       videos/long_*.mp4 <- src/demo/long_compare.py  (~20 giay/video)
#     Con so rut ra tu chung van duoc commit trong results/demo/. ---
results/demo/sbs_*.mp4
results/demo/videos/long_*.mp4

# --- Video 3 panel Giai doan F (13 MB, tai tao bang omega_suppress.py --render) ---
results/demo/videos/suppress3_*.mp4

# --- Video demo khoa luan (outputs/thesis_demos): video MP4, anh PNG render va
#     cache chay lai tracker. Tai tao duoc bang src/demo/render_thesis_demo.py
#     --no-cache (~5 phut GPU). CHI ignore video/anh/cache - KHONG ignore ca
#     thu muc outputs/thesis_demos/, vi DEMO_REPORT.md, CSV va metadata.json
#     van phai duoc theo doi de tai lap. ---
outputs/thesis_demos/*.mp4
outputs/thesis_demos/*/*.png
outputs/thesis_demos/*/rerun/
